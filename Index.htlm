<body lang="en-US" link="#000080" vlink="#800000" dir="ltr"><pre class="western">
&lt;!-- Topo / Header --&gt;&lt;header class=&quot;bg-black border-b border-gold/30 sticky top-z-50 z-40&quot;&gt; &lt;div class=&quot;max-w-7xl mx-auto px-4 py-4 flex flex-col md:flex-row justify-between items-center gap-4&quot;&gt; &lt;div class=&quot;flex items-center gap-3 cursor-pointer&quot; onclick=&quot;showSection('home')&quot;&gt; &lt;img src=&quot;1000474726.jpg&quot; alt=&quot;Logo Sakura &amp; Rêh&quot; class=&quot;w-12 h-12 object-cover rounded-full border border-gold&quot;&gt; &lt;div&gt; &lt;h1 class=&quot;text-2xl font-serif font-bold gold-text tracking-wide&quot;&gt;Sakura &amp; Rêh&lt;/h1&gt; &lt;p class=&quot;text-xs text-gray-400&quot;&gt;Bolsas, Acessórios e Elegância&lt;/p&gt; &lt;/div&gt; &lt;/div&gt; &lt;!-- Barra de Pesquisa e Navegação --&gt; &lt;div class=&quot;flex items-center gap-3 w-full md:w-auto&quot;&gt; &lt;input type=&quot;text&quot; id=&quot;searchInput&quot; placeholder=&quot;O que você procura?&quot; oninput=&quot;filterProducts()&quot; class=&quot;bg-neutral-900 border border-gold/40 rounded-full px-4 py-2 text-sm focus:outline-none focus:border-gold w-full md:w-64 text-white&quot;&gt; &lt;button onclick=&quot;openAdminLogin()&quot; class=&quot;text-xs border border-gold text-gold px-3 py-2 rounded-full hover:bg-gold hover:text-black transition&quot;&gt;Painel Admin&lt;/button&gt; &lt;/div&gt; &lt;/div&gt;&lt;/header&gt;&lt;!-- Conteúdo Principal --&gt;&lt;main class=&quot;flex-grow max-w-7xl mx-auto px-4 py-8 w-full&quot;&gt; &lt;!-- Seção Home / Início --&gt; &lt;section id=&quot;home-section&quot; class=&quot;space-y-12&quot;&gt; &lt;!-- Banner Principal --&gt; &lt;div class=&quot;relative rounded-2xl overflow-hidden border border-gold/30 bg-gradient-to-r from-neutral-900 via-black to-neutral-900 p-8 md:p-16 text-center shadow-2xl&quot;&gt; &lt;div class=&quot;max-w-2xl mx-auto space-y-4&quot;&gt; &lt;h2 class=&quot;text-3xl md:text-5xl font-serif font-bold gold-text&quot;&gt;Elegância e Sofisticação&lt;/h2&gt; &lt;p class=&quot;text-gray-300 text-sm md:text-base&quot;&gt;Explore nossa coleção exclusiva de bolsas, malas, mochilas, kits maternidade e acessórios selecionados especialmente para você.&lt;/p&gt; &lt;button onclick=&quot;showSection('catalog')&quot; class=&quot;mt-4 gold-gradient text-black font-semibold px-8 py-3 rounded-full shadow-lg hover:opacity-95 transition transform hover:scale-105&quot;&gt;Ver Catálogo Completo&lt;/button&gt; &lt;/div&gt; &lt;/div&gt; &lt;!-- Categorias --&gt; &lt;div&gt; &lt;h3 class=&quot;text-2xl font-serif font-semibold mb-6 border-l-4 border-gold pl-3 text-gold&quot;&gt;Nossas Categorias&lt;/h3&gt; &lt;div class=&quot;grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-4&quot; id=&quot;categories-grid&quot;&gt; &lt;!-- Gerado por JS --&gt; &lt;/div&gt; &lt;/div&gt; &lt;!-- Destaques --&gt; &lt;div&gt; &lt;h3 class=&quot;text-2xl font-serif font-semibold mb-6 border-l-4 border-gold pl-3 text-gold&quot;&gt;Destaques da Coleção&lt;/h3&gt; &lt;div class=&quot;grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6&quot; id=&quot;featured-grid&quot;&gt; &lt;!-- Gerado por JS --&gt; &lt;/div&gt; &lt;/div&gt; &lt;/section&gt; &lt;!-- Seção Catálogo Completo --&gt; &lt;section id=&quot;catalog-section&quot; class=&quot;hidden space-y-8&quot;&gt; &lt;div class=&quot;flex flex-col md:flex-row justify-between items-center gap-4 border-b border-gold/20 pb-4&quot;&gt; &lt;h2 class=&quot;text-3xl font-serif font-bold gold-text&quot;&gt;Catálogo Completo&lt;/h2&gt; &lt;div id=&quot;category-filters&quot; class=&quot;flex flex-wrap gap-2&quot;&gt; &lt;!-- Filtros gerados por JS --&gt; &lt;/div&gt; &lt;/div&gt; &lt;div class=&quot;grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6&quot; id=&quot;catalog-grid&quot;&gt; &lt;!-- Gerado por JS --&gt; &lt;/div&gt; &lt;/section&gt; &lt;!-- Seção Detalhes do Produto Individual --&gt; &lt;section id=&quot;detail-section&quot; class=&quot;hidden max-w-4xl mx-auto bg-neutral-900 border border-gold/30 rounded-2xl p-6 md:p-10 shadow-2xl&quot;&gt; &lt;button onclick=&quot;showSection('catalog')&quot; class=&quot;text-gold text-sm mb-6 hover:underline flex items-center gap-1&quot;&gt;← Voltar ao Catálogo&lt;/button&gt; &lt;div class=&quot;grid grid-cols-1 md:grid-cols-2 gap-8&quot;&gt; &lt;div class=&quot;rounded-xl overflow-hidden border border-gold/20 bg-black flex items-center justify-center&quot;&gt; &lt;img id=&quot;detail-img&quot; src=&quot;&quot; alt=&quot;Produto&quot; class=&quot;w-full h-80 object-cover&quot;&gt; &lt;/div&gt; &lt;div class=&quot;space-y-4&quot;&gt; &lt;span id=&quot;detail-category&quot; class=&quot;text-xs uppercase tracking-widest bg-gold/10 text-gold px-3 py-1 rounded-full border border-gold/30&quot;&gt;&lt;/span&gt; &lt;h2 id=&quot;detail-name&quot; class=&quot;text-3xl font-serif font-bold text-white&quot;&gt;&lt;/h2&gt; &lt;p id=&quot;detail-price&quot; class=&quot;text-2xl font-bold gold-text&quot;&gt;&lt;/p&gt; &lt;p id=&quot;detail-measures&quot; class=&quot;text-sm text-gray-300&quot;&gt;&lt;/p&gt; &lt;!-- Opções de Cor --&gt; &lt;div class=&quot;space-y-1&quot;&gt; &lt;label class=&quot;text-xs font-semibold text-gray-400&quot;&gt;Opções de Cor:&lt;/label&gt; &lt;div id=&quot;detail-colors&quot; class=&quot;flex gap-2&quot;&gt;&lt;/div&gt; &lt;/div&gt; &lt;!-- Opções de Tamanho --&gt; &lt;div class=&quot;space-y-1&quot;&gt; &lt;label class=&quot;text-xs font-semibold text-gray-400&quot;&gt;Opções de Tamanho:&lt;/label&gt; &lt;div id=&quot;detail-sizes&quot; class=&quot;flex gap-2&quot;&gt;&lt;/div&gt; &lt;/div&gt; &lt;button onclick=&quot;openOrderModal()&quot; class=&quot;w-full gold-gradient text-black font-bold py-3 rounded-xl shadow-lg hover:opacity-95 transition mt-4&quot;&gt;Fazer Pedido&lt;/button&gt; &lt;/div&gt; &lt;/div&gt; &lt;/section&gt; &lt;!-- Painel Administrativo --&gt; &lt;section id=&quot;admin-section&quot; class=&quot;hidden max-w-5xl mx-auto space-y-6&quot;&gt; &lt;div class=&quot;flex justify-between items-center border-b border-gold/20 pb-4&quot;&gt; &lt;h2 class=&quot;text-3xl font-serif font-bold gold-text&quot;&gt;Painel Administrativo&lt;/h2&gt; &lt;button onclick=&quot;showSection('home')&quot; class=&quot;text-sm text-gray-400 hover:text-gold&quot;&gt;Sair do Painel&lt;/button&gt; &lt;/div&gt; &lt;!-- Abas do Admin --&gt; &lt;div class=&quot;flex gap-4 border-b border-neutral-800 pb-2&quot;&gt; &lt;button onclick=&quot;switchAdminTab('add')&quot; id=&quot;tab-add&quot; class=&quot;text-gold font-semibold pb-1 border-b-2 border-gold&quot;&gt;Cadastrar Produto&lt;/button&gt; &lt;button onclick=&quot;switchAdminTab('manage')&quot; id=&quot;tab-manage&quot; class=&quot;text-gray-400 hover:text-gold pb-1&quot;&gt;Gerenciar Produtos&lt;/button&gt; &lt;button onclick=&quot;switchAdminTab('orders')&quot; id=&quot;tab-orders&quot; class=&quot;text-gray-400 hover:text-gold pb-1&quot;&gt;Ver Pedidos (Banco)&lt;/button&gt; &lt;/div&gt; &lt;!-- Aba Cadastrar --&gt; &lt;div id=&quot;admin-add-tab&quot; class=&quot;space-y-4 bg-neutral-900 p-6 rounded-xl border border-gold/20&quot;&gt; &lt;h3 class=&quot;text-xl font-serif text-gold&quot;&gt;Adicionar Novo Produto&lt;/h3&gt; &lt;form id=&quot;addProductForm&quot; onsubmit=&quot;handleAddNewProduct(event)&quot; class=&quot;grid grid-cols-1 md:grid-cols-2 gap-4&quot;&gt; &lt;div&gt; &lt;label class=&quot;text-xs text-gray-400&quot;&gt;Nome do Produto&lt;/label&gt; &lt;input type=&quot;text&quot; id=&quot;new-name&quot; required class=&quot;w-full bg-black border border-gold/30 rounded p-2 text-white text-sm&quot;&gt; &lt;/div&gt; &lt;div&gt; &lt;label class=&quot;text-xs text-gray-400&quot;&gt;Categoria&lt;/label&gt; &lt;select id=&quot;new-category&quot; class=&quot;w-full bg-black border border-gold/30 rounded p-2 text-white text-sm&quot;&gt; &lt;option value=&quot;bolsas&quot;&gt;Bolsas&lt;/option&gt; &lt;option value=&quot;mochilas&quot;&gt;Mochilas&lt;/option&gt; &lt;option value=&quot;malas&quot;&gt;Malas&lt;/option&gt; &lt;option value=&quot;necessaires&quot;&gt;Necessaires&lt;/option&gt; &lt;option value=&quot;maternidade&quot;&gt;Kits Maternidade&lt;/option&gt; &lt;option value=&quot;organizadores&quot;&gt;Organizadores&lt;/option&gt; &lt;option value=&quot;pastas&quot;&gt;Pastas&lt;/option&gt; &lt;option value=&quot;pochetes&quot;&gt;Pochetes&lt;/option&gt; &lt;option value=&quot;acessorios&quot;&gt;Acessórios&lt;/option&gt; &lt;/select&gt; &lt;/div&gt; &lt;div&gt; &lt;label class=&quot;text-xs text-gray-400&quot;&gt;Valor (R$)&lt;/label&gt; &lt;input type=&quot;number&quot; step=&quot;0.01&quot; id=&quot;new-price&quot; required class=&quot;w-full bg-black border border-gold/30 rounded p-2 text-white text-sm&quot;&gt; &lt;/div&gt; &lt;div&gt; &lt;label class=&quot;text-xs text-gray-400&quot;&gt;Medidas&lt;/label&gt; &lt;input type=&quot;text&quot; id=&quot;new-measures&quot; placeholder=&quot;Ex: 30cm x 20cm&quot; required class=&quot;w-full bg-black border border-gold/30 rounded p-2 text-white text-sm&quot;&gt; &lt;/div&gt; &lt;div&gt; &lt;label class=&quot;text-xs text-gray-400&quot;&gt;3 Opções de Cores (separadas por vírgula)&lt;/label&gt; &lt;input type=&quot;text&quot; id=&quot;new-colors&quot; placeholder=&quot;Preto, Dourado, Branco&quot; required class=&quot;w-full bg-black border border-gold/30 rounded p-2 text-white text-sm&quot;&gt; &lt;/div&gt; &lt;div&gt; &lt;label class=&quot;text-xs text-gray-400&quot;&gt;3 Opções de Tamanhos (separadas por vírgula)&lt;/label&gt; &lt;input type=&quot;text&quot; id=&quot;new-sizes&quot; placeholder=&quot;Pequeno, Médio, Grande&quot; required class=&quot;w-full bg-black border border-gold/30 rounded p-2 text-white text-sm&quot;&gt; &lt;/div&gt; &lt;div class=&quot;md:col-span-2&quot;&gt; &lt;label class=&quot;text-xs text-gray-400&quot;&gt;Link da Imagem (URL)&lt;/label&gt; &lt;input type=&quot;url&quot; id=&quot;new-image&quot; placeholder=&quot;
&quot; required class=&quot;w-full bg-black border border-gold/30 rounded p-2 text-white text-sm&quot;&gt; &lt;/div&gt; &lt;div class=&quot;md:col-span-2&quot;&gt; &lt;button type=&quot;submit&quot; class=&quot;w-full gold-gradient text-black font-bold py-3 rounded shadow hover:opacity-95 transition&quot;&gt;Cadastrar Produto&lt;/button&gt; &lt;/div&gt; &lt;/form&gt; &lt;/div&gt; &lt;!-- Aba Gerenciar --&gt; &lt;div id=&quot;admin-manage-tab&quot; class=&quot;hidden space-y-4 bg-neutral-900 p-6 rounded-xl border border-gold/20&quot;&gt; &lt;h3 class=&quot;text-xl font-serif text-gold&quot;&gt;Lista de Produtos Cadastrados&lt;/h3&gt; &lt;div class=&quot;overflow-x-auto&quot;&gt; &lt;table class=&quot;w-full text-left text-sm&quot;&gt; &lt;thead&gt; &lt;tr class=&quot;border-b border-neutral-800 text-gold&quot;&gt; &lt;th class=&quot;p-2&quot;&gt;Nome&lt;/th&gt; &lt;th class=&quot;p-2&quot;&gt;Categoria&lt;/th&gt; &lt;th class=&quot;p-2&quot;&gt;Preço&lt;/th&gt; &lt;th class=&quot;p-2&quot;&gt;Ações&lt;/th&gt; &lt;/tr&gt; &lt;/thead&gt; &lt;tbody id=&quot;admin-products-list&quot;&gt; &lt;!-- Gerado por JS --&gt; &lt;/tbody&gt; &lt;/table&gt; &lt;/div&gt; &lt;/div&gt; &lt;!-- Aba Pedidos --&gt; &lt;div id=&quot;admin-orders-tab&quot; class=&quot;hidden space-y-4 bg-neutral-900 p-6 rounded-xl border border-gold/20&quot;&gt; &lt;h3 class=&quot;text-xl font-serif text-gold&quot;&gt;Pedidos Salvos no Banco de Dados&lt;/h3&gt; &lt;div class=&quot;overflow-x-auto&quot;&gt; &lt;table class=&quot;w-full text-left text-sm&quot;&gt; &lt;thead&gt; &lt;tr class=&quot;border-b border-neutral-800 text-gold&quot;&gt; &lt;th class=&quot;p-2&quot;&gt;Data/Hora&lt;/th&gt; &lt;th class=&quot;p-2&quot;&gt;Cliente&lt;/th&gt; &lt;th class=&quot;p-2&quot;&gt;Telefone&lt;/th&gt; &lt;th class=&quot;p-2&quot;&gt;Produto&lt;/th&gt; &lt;th class=&quot;p-2&quot;&gt;Cor / Tamanho&lt;/th&gt; &lt;/tr&gt; &lt;/thead&gt; &lt;tbody id=&quot;admin-orders-list&quot;&gt; &lt;!-- Gerado por JS --&gt; &lt;/tbody&gt; &lt;/table&gt; &lt;/div&gt; &lt;/div&gt; &lt;/section&gt;&lt;/main&gt;&lt;!-- Modal de Senha do Admin --&gt;&lt;div id=&quot;admin-modal&quot; class=&quot;fixed inset-0 bg-black/80 hidden z-50 flex items-center justify-center p-4&quot;&gt; &lt;div class=&quot;bg-neutral-900 border border-gold/40 rounded-2xl p-6 max-w-sm w-full space-y-4&quot;&gt; &lt;h3 class=&quot;text-xl font-serif text-gold&quot;&gt;Acesso Restrito&lt;/h3&gt; &lt;p class=&quot;text-xs text-gray-400&quot;&gt;Digite a senha para acessar o painel administrativo.&lt;/p&gt; &lt;input type=&quot;password&quot; id=&quot;admin-password-input&quot; placeholder=&quot;Senha&quot; class=&quot;w-full bg-black border border-gold/30 rounded p-2 text-white text-sm&quot;&gt; &lt;div class=&quot;flex gap-2&quot;&gt; &lt;button onclick=&quot;closeAdminModal()&quot; class=&quot;w-1/2 bg-neutral-800 text-gray-300 py-2 rounded text-sm&quot;&gt;Cancelar&lt;/button&gt; &lt;button onclick=&quot;verifyAdminPassword()&quot; class=&quot;w-1/2 gold-gradient text-black font-bold py-2 rounded text-sm&quot;&gt;Entrar&lt;/button&gt; &lt;/div&gt; &lt;/div&gt;&lt;/div&gt;&lt;!-- Modal de Fazer Pedido --&gt;&lt;div id=&quot;order-modal&quot; class=&quot;fixed inset-0 bg-black/80 hidden z-50 flex items-center justify-center p-4&quot;&gt; &lt;div class=&quot;bg-neutral-900 border border-gold/40 rounded-2xl p-6 max-w-md w-full space-y-4&quot;&gt; &lt;div class=&quot;flex justify-between items-center&quot;&gt; &lt;h3 class=&quot;text-xl font-serif text-gold&quot;&gt;Finalizar Pedido&lt;/h3&gt; &lt;button onclick=&quot;closeOrderModal()&quot; class=&quot;text-gray-400 hover:text-white&quot;&gt;✕&lt;/button&gt; &lt;/div&gt; &lt;form id=&quot;orderForm&quot; onsubmit=&quot;submitOrder(event)&quot; class=&quot;space-y-3&quot;&gt; &lt;div&gt; &lt;label class=&quot;text-xs text-gray-400&quot;&gt;Seu Nome&lt;/label&gt; &lt;input type=&quot;text&quot; id=&quot;client-name&quot; required class=&quot;w-full bg-black border border-gold/30 rounded p-2 text-white text-sm&quot;&gt; &lt;/div&gt; &lt;div&gt; &lt;label class=&quot;text-xs text-gray-400&quot;&gt;Seu WhatsApp (Telefone)&lt;/label&gt; &lt;input type=&quot;text&quot; id=&quot;client-phone&quot; placeholder=&quot;(21) 99999-9999&quot; required class=&quot;w-full bg-black border border-gold/30 rounded p-2 text-white text-sm&quot;&gt; &lt;/div&gt; &lt;div&gt; &lt;label class=&quot;text-xs text-gray-400&quot;&gt;Produto Escolhido&lt;/label&gt; &lt;input type=&quot;text&quot; id=&quot;order-product-name&quot; readonly class=&quot;w-full bg-black/50 border border-gold/20 rounded p-2 text-gray-300 text-sm&quot;&gt; &lt;/div&gt; &lt;div class=&quot;grid grid-cols-2 gap-2&quot;&gt; &lt;div&gt; &lt;label class=&quot;text-xs text-gray-400&quot;&gt;Cor Selecionada&lt;/label&gt; &lt;input type=&quot;text&quot; id=&quot;order-product-color&quot; readonly class=&quot;w-full bg-black/50 border border-gold/20 rounded p-2 text-gray-300 text-sm&quot;&gt; &lt;/div&gt; &lt;div&gt; &lt;label class=&quot;text-xs text-gray-400&quot;&gt;Tamanho Selecionado&lt;/label&gt; &lt;input type=&quot;text&quot; id=&quot;order-product-size&quot; readonly class=&quot;w-full bg-black/50 border border-gold/20 rounded p-2 text-gray-300 text-sm&quot;&gt; &lt;/div&gt; &lt;/div&gt; &lt;button type=&quot;submit&quot; class=&quot;w-full gold-gradient text-black font-bold py-3 rounded-xl shadow hover:opacity-95 transition mt-2&quot;&gt;Confirmar e Enviar para WhatsApp&lt;/button&gt; &lt;/form&gt; &lt;/div&gt;&lt;/div&gt;&lt;!-- Rodapé --&gt;&lt;footer class=&quot;bg-black border-t border-gold/30 py-8 mt-12 text-center text-xs text-gray-400 space-y-2&quot;&gt; &lt;div class=&quot;flex justify-center items-center gap-2&quot;&gt; &lt;img src=&quot;1000474726.jpg&quot; alt=&quot;Logo&quot; class=&quot;w-8 h-8 rounded-full border border-gold&quot;&gt; &lt;span class=&quot;font-serif text-gold font-bold text-sm&quot;&gt;Sakura &amp; Rêh&lt;/span&gt; &lt;/div&gt; &lt;p&gt;Rio de Janeiro - RJ&lt;/p&gt; &lt;p&gt;WhatsApp: (21) 972371504 | Instagram: @sakura_reh&lt;/p&gt; &lt;p class=&quot;text-gray-500&quot;&gt;CPF: [Seu CPF aqui]&lt;/p&gt; &lt;p class=&quot;text-[10px] text-neutral-600 mt-4&quot;&gt;© 2026 Sakura &amp; Rêh - Todos os direitos reservados.&lt;/p&gt;&lt;/footer&gt;&lt;!-- Lógica JavaScript e Banco de Dados --&gt;&lt;script&gt; // Configuração Firebase (Simulada/Padrão para armazenamento web local ou nuvem) // Substitua abaixo pelas suas credenciais do Firebase caso deseje salvar online const firebaseConfig = { apiKey: &quot;AIzaSyDummyKeyForDemoPurposes12345&quot;, authDomain: &quot;sakura-reh.firebaseapp.com&quot;, projectId: &quot;sakura-reh&quot;, storageBucket: &quot;sakura-reh.appspot.com&quot;, messagingSenderId: &quot;123456789&quot;, appId: &quot;1:123456789:web:abcdef&quot; }; let db; try { firebase.initializeApp(firebaseConfig); db = firebase.firestore(); } catch(e) { console.log(&quot;Firebase rodando em modo local/offline&quot;); } // Categorias e Produtos Iniciais (Garantindo 20+ por categoria estruturada) const categories = [ { id: 'bolsas', name: 'Bolsas', icon: '👜' }, { id: 'mochilas', name: 'Mochilas', icon: '🎒' }, { id: 'malas', name: 'Malas', icon: '🧳' }, { id: 'necessaires', name: 'Necessaires', icon: '👝' }, { id: 'maternidade', name: 'Kits Maternidade', icon: '🍼' }, { id: 'organizadores', name: 'Organizadores', icon: '📦' }, { id: 'pastas', name: 'Pastas', icon: '📁' }, { id: 'pochetes', name: 'Pochetes', icon: '👛' }, { id: 'acessorios', name: 'Acessórios', icon: '✨' } ]; // Gerando base de produtos rica para bater a quantidade solicitada let products = []; const baseNames = { bolsas: [&quot;Bolsa Luxo Executive&quot;, &quot;Bolsa Matelassê Dourada&quot;, &quot;Bolsa Transversal Class&quot;, &quot;Bolsa Tote Elegance&quot;, &quot;Bolsa Sacola Prestige&quot;, &quot;Bolsa de Ombro Saphire&quot;, &quot;Bolsa Casual Chic&quot;, &quot;Bolsa Festa Shine&quot;, &quot;Bolsa Baú Vintage&quot;, &quot;Bolsa Monet&quot;, &quot;Bolsa Verão Gold&quot;, &quot;Bolsa Urban Style&quot;, &quot;Bolsa Minimal Black&quot;, &quot;Bolsa Soft Touch&quot;, &quot;Bolsa Royal Diamond&quot;, &quot;Bolsa Dubai Edition&quot;, &quot;Bolsa Parisienne&quot;, &quot;Bolsa Metropolitan&quot;, &quot;Bolsa Velvet Gold&quot;, &quot;Bolsa Piazza&quot;], mochilas: [&quot;Mochila Executiva Impermeável&quot;, &quot;Mochila Casual Dourada&quot;, &quot;Mochila Escolar Premium&quot;, &quot;Mochila Notebook Slim&quot;, &quot;Mochila Urban Refined&quot;, &quot;Mochila Viagem Comfort&quot;, &quot;Mochila Compact Lux&quot;, &quot;Mochila Velvet Style&quot;, &quot;Mochila Sport Chic&quot;, &quot;Mochila Minimalist Black&quot;, &quot;Mochila Touch Gold&quot;, &quot;Mochila Star Shine&quot;, &quot;Mochila Business Pro&quot;, &quot;Mochila Day by Day&quot;, &quot;Mochila Active Luxury&quot;, &quot;Mochila Classic Line&quot;, &quot;Mochila Soft Code&quot;, &quot;Mochila Master Series&quot;, &quot;Mochila Grand Voyager&quot;, &quot;Mochila Prestige&quot;], malas: [&quot;Mala de Bordo Rigida Gold&quot;, &quot;Mala Viagem Grande Executive&quot;, &quot;Mala Média com Rodinhas 360&quot;, &quot;Mala Executiva de Mão&quot;, &quot;Mala Viagem Premium Black&quot;, &quot;Mala Compact Lux&quot;, &quot;Mala Diamond Edition&quot;, &quot;Mala Weekend Trip&quot;, &quot;Mala Classic Travel&quot;, &quot;Mala Global Explorer&quot;, &quot;Mala Sky Master&quot;, &quot;Mala Royal Flight&quot;, &quot;Mala Jetset Black&quot;, &quot;Mala Voyager Gold&quot;, &quot;Mala First Class&quot;, &quot;Mala Horizon Pro&quot;, &quot;Mala Odyssey Lux&quot;, &quot;Mala Prestige Trip&quot;, &quot;Mala Supreme Journey&quot;, &quot;Mala Elite Boarding&quot;], necessaires: [&quot;Necessaire Viagem Impermeável&quot;, &quot;Necessaire Golden Zipper&quot;, &quot;Necessaire Média Make&quot;, &quot;Necessaire Masculina Executiva&quot;, &quot;Necessaire Compacta Black&quot;, &quot;Necessaire Dupla Face&quot;, &quot;Necessaire Luxo Matelassê&quot;, &quot;Necessaire Velvet Touch&quot;, &quot;Necessaire Organizadora Pro&quot;, &quot;Necessaire Estojo Chic&quot;, &quot;Necessaire Day Trip&quot;, &quot;Necessaire Golden Hour&quot;, &quot;Necessaire Minimal Black&quot;, &quot;Necessaire Saphire Line&quot;, &quot;Necessaire Royal Make&quot;, &quot;Necessaire Diamond Case&quot;, &quot;Necessaire Urban Bag&quot;, &quot;Necessaire Soft Beauty&quot;, &quot;Necessaire Master Kit&quot;, &quot;Necessaire Prestige Gold&quot;], maternidade: [&quot;Kit Maternidade 5 Peças Luxo&quot;, &quot;Bolsa Maternidade Grande Dourada&quot;, &quot;Mochila Maternidade Multifuncional&quot;, &quot;Frasqueira Térmica Maternidade&quot;, &quot;Trocador Portátil Acolchoado&quot;, &quot;Kit Bolsa Maternidade Prestige&quot;, &quot;Mochila Térmica Bebê Gold&quot;, &quot;Bolsa Maternidade Royal Blue&quot;, &quot;Kit Saída Maternidade Chic&quot;, &quot;Bolsa Bebê Matelassê Black&quot;, &quot;Mochila Maternidade Master&quot;, &quot;Frasqueira Luxo Bebê&quot;, &quot;Kit Maternidade Complete&quot;, &quot;Bolsa Maternidade Soft Touch&quot;, &quot;Mochila Maternidade Elegance&quot;, &quot;Trocador Luxo Confort&quot;, &quot;Bolsa Maternidade Classic&quot;, &quot;Mochila Maternidade Star&quot;, &quot;Kit Maternidade Premium&quot;, &quot;Bolsa Maternidade Supreme&quot;], organizadores: [&quot;Organizador de Mala 6 Peças&quot;, &quot;Necessaire Organizadora Closet&quot;, &quot;Organizador de Bolsa Multifunção&quot;, &quot;Colmeia Organizadora de Gaveta&quot;, &quot;Organizador de Sapatos Luxo&quot;, &quot;Porta Joias Viagem Compacto&quot;, &quot;Organizador de Maquiagem Acrílico&quot;, &quot;Kit Organizadores Golden&quot;, &quot;Organizador Suspenso Closet&quot;, &quot;Porta Documentos Executivo&quot;, &quot;Organizador Nécessaire Box&quot;, &quot;Bolsa Organizadora Porta-Tudo&quot;, &quot;Organizador de Bolsas Interno&quot;, &quot;Porta Cartões e Acessórios&quot;, &quot;Organizador de Fios e Tech&quot;, &quot;Capa Protetora de Roupas&quot;, &quot;Organizador de Mala Premium&quot;, &quot;Necressaire Organizadora Dual&quot;, &quot;Organizador de Bolsa Velvet&quot;, &quot;Kit Organizador Master&quot;], pastas: [&quot;Pasta Executiva para Notebook&quot;, &quot;Pasta Fichário em Couro Lux&quot;, &quot;Pasta Portfólio Slim Dourada&quot;, &quot;Pasta Reunião Business Black&quot;, &quot;Pasta Documentos Impermeável&quot;, &quot;Pasta Executive Case&quot;, &quot;Pasta Class Gold Line&quot;, &quot;Pasta Universitaria Premium&quot;, &quot;Pasta Transversal Business&quot;, &quot;Pasta Master Pro&quot;, &quot;Pasta Organizer Office&quot;, &quot;Pasta Diplomata Luxo&quot;, &quot;Pasta Casual Office&quot;, &quot;Pasta Notebook Velvet&quot;, &quot;Pasta Suprema Line&quot;, &quot;Pasta Travel Work&quot;, &quot;Pasta Smart Business&quot;, &quot;Pasta Elite Office&quot;, &quot;Pasta Grand Work&quot;, &quot;Pasta Prestige Office&quot;], pochetes: [&quot;Pochete Luxo Transversal&quot;, &quot;Pochete Casual Dourada&quot;, &quot;Pochete Executiva Slim&quot;, &quot;Pochete Velvet Elegance&quot;, &quot;Pochete Sport Chic&quot;, &quot;Pochete Minimal Black&quot;, &quot;Pochete Gold Chain&quot;, &quot;Pochete Urban Style&quot;, &quot;Pochete Touch Soft&quot;, &quot;Pochete Day by Day&quot;, &quot;Pochete Classic Line&quot;, &quot;Pochete Master Series&quot;, &quot;Pochete Prestige&quot;, &quot;Pochete Saphire&quot;, &quot;Pochete Diamond&quot;, &quot;Pochete Night Out&quot;, &quot;Pochete Travel Fit&quot;, &quot;Pochete Active Lux&quot;, &quot;Pochete Grand Style&quot;, &quot;Pochete Supreme&quot;], acessorios: [&quot;Porta Cartões de Couro Gold&quot;, &quot;Carteira Feminina Executiva&quot;, &quot;Cinto Elegance Fivela Dourada&quot;, &quot;Porta Chaves Luxo&quot;, &quot;Capa de Passaporte e Documentos&quot;, &quot;Chaveiro Pompons Sakura&quot;, &quot;Carteira Slim Black&quot;, &quot;Porta Óculos Rígido Luxo&quot;, &quot;Espelho de Bolsa Dourado&quot;, &quot;Alça Removível para Bolsa&quot;, &quot;Cinto Double Side Gold&quot;, &quot;Porta Moedas Chic&quot;, &quot;Kit Higiene Pessoal Luxo&quot;, &quot;Necessaire Porta Relógio&quot;, &quot;Carteira Mão Envelope&quot;, &quot;Capa Protetora Passaporte&quot;, &quot;Organizador de Carteira&quot;, &quot;Etiqueta de Mala Personalizada&quot;, &quot;Porta Cartões Slim&quot;, &quot;Acessório Charm Golden&quot;] }; let idCounter = 1; for (let cat in baseNames) { baseNames[cat].forEach((name, idx) =&gt; { products.push({ id: idCounter++, name: name, category: cat, price: 129.90 + (idx * 15.50), measures: &quot;Altura: 30cm | Largura: 40cm | Profundidade: 15cm&quot;, colors: [&quot;Preto Clássico&quot;, &quot;Dourado Luxo&quot;, &quot;Branco Pérola&quot;], sizes: [&quot;Pequeno&quot;, &quot;Médio&quot;, &quot;Grande&quot;], image: &quot;
&quot; }); }); } let currentProduct = null; let selectedColor = &quot;&quot;; let selectedSize = &quot;&quot;; // Inicialização document.addEventListener('DOMContentLoaded', () =&gt; { renderCategories(); renderFeatured(); renderCatalogFilters(); renderCatalog(); }); function showSection(sectionId) { document.getElementById('home-section').classList.add('hidden'); document.getElementById('catalog-section').classList.add('hidden'); document.getElementById('detail-section').classList.add('hidden'); document.getElementById('admin-section').classList.add('hidden'); if(sectionId === 'home') document.getElementById('home-section').classList.remove('hidden'); if(sectionId === 'catalog') document.getElementById('catalog-section').classList.remove('hidden'); if(sectionId === 'detail') document.getElementById('detail-section').classList.remove('hidden'); if(sectionId === 'admin') document.getElementById('admin-section').classList.remove('hidden'); window.scrollTo(0,0); } function renderCategories() { const grid = document.getElementById('categories-grid'); grid.innerHTML = categories.map(cat =&gt; ` &lt;div onclick=&quot;filterByCategory('${cat.id}')&quot; class=&quot;bg-neutral-900 border border-gold/30 hover:border-gold rounded-xl p-4 text-center cursor-pointer transition transform hover:-translate-y-1 shadow-md&quot;&gt; &lt;div class=&quot;text-3xl mb-2&quot;&gt;${cat.icon}&lt;/div&gt; &lt;span class=&quot;text-xs font-semibold text-gray-200&quot;&gt;${cat.name}&lt;/span&gt; &lt;/div&gt; `).join(''); } function renderFeatured() { const grid = document.getElementById('featured-grid'); const featured = products.slice(0, 8); grid.innerHTML = featured.map(p =&gt; productCardHtml(p)).join(''); } function renderCatalogFilters() { const container = document.getElementById('category-filters'); container.innerHTML = `&lt;button onclick=&quot;filterByCategory('all')&quot; class=&quot;text-xs px-3 py-1.5 rounded-full border border-gold bg-gold text-black font-semibold&quot;&gt;Todos&lt;/button&gt;` + categories.map(cat =&gt; `&lt;button onclick=&quot;filterByCategory('${cat.id}')&quot; class=&quot;text-xs px-3 py-1.5 rounded-full border border-gold/40 text-gray-300 hover:border-gold&quot;&gt;${cat.name}&lt;/button&gt;`).join(''); } function renderCatalog(filter = 'all', search = '') { const grid = document.getElementById('catalog-grid'); let filtered = products; if(filter !== 'all') { filtered = filtered.filter(p =&gt; p.category === filter); } if(search.trim() !== '') { filtered = filtered.filter(p =&gt; p.name.toLowerCase().includes(search.toLowerCase())); } if(filtered.length === 0) { grid.innerHTML = `&lt;p class=&quot;col-span-full text-center text-gray-400 py-12&quot;&gt;Nenhum produto encontrado.&lt;/p&gt;`; return; } grid.innerHTML = filtered.map(p =&gt; productCardHtml(p)).join(''); } function productCardHtml(p) { return ` &lt;div class=&quot;bg-neutral-900 border border-gold/30 rounded-xl overflow-hidden shadow-xl flex flex-col justify-between group&quot;&gt; &lt;div class=&quot;overflow-hidden bg-black h-48 relative&quot;&gt; &lt;img src=&quot;${p.image}&quot; alt=&quot;${p.name}&quot; class=&quot;w-full h-full object-cover group-hover:scale-105 transition duration-500&quot;&gt; &lt;/div&gt; &lt;div class=&quot;p-4 space-y-2 flex-grow flex flex-col justify-between&quot;&gt; &lt;div&gt; &lt;span class=&quot;text-[10px] uppercase text-gold tracking-widest&quot;&gt;${p.category}&lt;/span&gt; &lt;h4 class=&quot;font-serif font-bold text-base text-white line-clamp-1&quot;&gt;${p.name}&lt;/h4&gt; &lt;p class=&quot;text-sm font-semibold text-gold&quot;&gt;R$ ${p.price.toFixed(2).replace('.', ',')}&lt;/p&gt; &lt;/div&gt; &lt;button onclick=&quot;openDetail(${p.id})&quot; class=&quot;w-full mt-2 border border-gold text-gold text-xs py-2 rounded-lg hover:bg-gold hover:text-black font-semibold transition&quot;&gt;Ver Detalhes&lt;/button&gt; &lt;/div&gt; &lt;/div&gt; `; } function filterByCategory(catId) { showSection('catalog'); renderCatalog(catId); } function filterProducts() { const query = document.getElementById('searchInput').value; showSection('catalog'); renderCatalog('all', query); } function openDetail(id) { currentProduct = products.find(p =&gt; p.id === id); if(!currentProduct) return; document.getElementById('detail-img').src = currentProduct.image; document.getElementById('detail-category').innerText = currentProduct.category; document.getElementById('detail-name').innerText = currentProduct.name; document.getElementById('detail-price').innerText = `R$ ${currentProduct.price.toFixed(2).replace('.', ',')}`; document.getElementById('detail-measures').innerText = `Medidas: ${currentProduct.measures}`; selectedColor = currentProduct.colors[0]; selectedSize = currentProduct.sizes[0]; document.getElementById('detail-colors').innerHTML = currentProduct.colors.map((c, idx) =&gt; ` &lt;button onclick=&quot;selectColor('${c}')&quot; class=&quot;px-3 py-1 rounded border text-xs ${idx === 0 ? 'border-gold bg-gold/20 text-gold' : 'border-neutral-700 text-gray-300'}&quot; id=&quot;col-${c}&quot;&gt;${c}&lt;/button&gt; `).join(''); document.getElementById('detail-sizes').innerHTML = currentProduct.sizes.map((s, idx) =&gt; ` &lt;button onclick=&quot;selectSize('${s}')&quot; class=&quot;px-3 py-1 rounded border text-xs ${idx === 0 ? 'border-gold bg-gold/20 text-gold' : 'border-neutral-700 text-gray-300'}&quot; id=&quot;siz-${s}&quot;&gt;${s}&lt;/button&gt; `).join(''); showSection('detail'); } function selectColor(color) { selectedColor = color; currentProduct.colors.forEach(c =&gt; { const el = document.getElementById(`col-${c}`); if(el) { if(c === color) { el.className = &quot;px-3 py-1 rounded border text-xs border-gold bg-gold/20 text-gold&quot;; } else { el.className = &quot;px-3 py-1 rounded border text-xs border-neutral-700 text-gray-300&quot;; } } }); } function selectSize(size) { selectedSize = size; currentProduct.sizes.forEach(s =&gt; { const el = document.getElementById(`siz-${s}`); if(el) { if(s === size) { el.className = &quot;px-3 py-1 rounded border text-xs border-gold bg-gold/20 text-gold&quot;; } else { el.className = &quot;px-3 py-1 rounded border text-xs border-neutral-700 text-gray-300&quot;; } } }); } function openOrderModal() { if(!currentProduct) return; document.getElementById('order-product-name').value = currentProduct.name; document.getElementById('order-product-color').value = selectedColor; document.getElementById('order-product-size').value = selectedSize; document.getElementById('order-modal').classList.remove('hidden'); } function closeOrderModal() { document.getElementById('order-modal').classList.add('hidden'); } function submitOrder(e) { e.preventDefault(); const clientName = document.getElementById('client-name').value; const clientPhone = document.getElementById('client-phone').value; const orderData = { clientName, clientPhone, productName: currentProduct.name, color: selectedColor, size: selectedSize, timestamp: new Date().toLocaleString() }; // Salvar no Firestore se disponível, senão localStorage if(db) { db.collection(&quot;orders&quot;).add(orderData).catch(err =&gt; console.log(err)); } else { let localOrders = JSON.parse(localStorage.getItem('sakura_orders') || '[]'); localOrders.push(orderData); localStorage.setItem('sakura_orders', JSON.stringify(localOrders)); } // Redirecionamento para WhatsApp solicitado const msg = `Olá! Gostaria de fazer um pedido:%0A%0A*Cliente:* ${clientName}%0A*Telefone:* ${clientPhone}%0A*Produto:* ${currentProduct.name}%0A*Cor:* ${selectedColor}%0A*Tamanho:* ${selectedSize}%0A*Valor:* R$ ${currentProduct.price.toFixed(2)}`; window.location.href = `
 } // Funções do Painel Admin function openAdminLogin() { document.getElementById('admin-modal').classList.remove('hidden'); } function closeAdminModal() { document.getElementById('admin-modal').classList.add('hidden'); } function verifyAdminPassword() { const pass = document.getElementById('admin-password-input').value; if(pass === 'sakura2026') { closeAdminModal(); document.getElementById('admin-password-input').value = ''; showSection('admin'); renderAdminManageList(); renderAdminOrdersList(); } else { alert('Senha incorreta!'); } } function switchAdminTab(tab) { document.getElementById('admin-add-tab').classList.add('hidden'); document.getElementById('admin-manage-tab').classList.add('hidden'); document.getElementById('admin-orders-tab').classList.add('hidden'); document.getElementById('tab-add').className = &quot;text-gray-400 hover:text-gold pb-1&quot;; document.getElementById('tab-manage').className = &quot;text-gray-400 hover:text-gold pb-1&quot;; document.getElementById('tab-orders').className = &quot;text-gray-400 hover:text-gold pb-1&quot;; if(tab === 'add') { document.getElementById('admin-add-tab').classList.remove('hidden'); document.getElementById('tab-add').className = &quot;text-gold font-semibold pb-1 border-b-2 border-gold&quot;; } else if(tab === 'manage') { document.getElementById('admin-manage-tab').classList.remove('hidden'); document.getElementById('tab-manage').className = &quot;text-gold font-semibold pb-1 border-b-2 border-gold&quot;; renderAdminManageList(); } else if(tab === 'orders') { document.getElementById('admin-orders-tab').classList.remove('hidden'); document.getElementById('tab-orders').className = &quot;text-gold font-semibold pb-1 border-b-2 border-gold&quot;; renderAdminOrdersList(); } } function handleAddNewProduct(e) { e.preventDefault(); const newP = { id: products.length + 1, name: document.getElementById('new-name').value, category: document.getElementById('new-category').value, price: parseFloat(document.getElementById('new-price').value), measures: document.getElementById('new-measures').value, colors: document.getElementById('new-colors').value.split(',').map(s =&gt; s.trim()), sizes: document.getElementById('new-sizes').value.split(',').map(s =&gt; s.trim()), image: document.getElementById('new-image').value }; products.unshift(newP); alert('Produto cadastrado com sucesso!'); document.getElementById('addProductForm').reset(); renderFeatured(); renderCatalog(); } function renderAdminManageList() { const tbody = document.getElementById('admin-products-list'); tbody.innerHTML = products.map(p =&gt; ` &lt;tr class=&quot;border-b border-neutral-800&quot;&gt; &lt;td class=&quot;p-2&quot;&gt;${p.name}&lt;/td&gt; &lt;td class=&quot;p-2 uppercase text-xs text-gold&quot;&gt;${p.category}&lt;/td&gt; &lt;td class=&quot;p-2&quot;&gt;R$ ${p.price.toFixed(2)}&lt;/td&gt; &lt;td class=&quot;p-2&quot;&gt;&lt;button onclick=&quot;deleteProduct(${p.id})&quot; class=&quot;text-red-400 text-xs hover:underline&quot;&gt;Excluir&lt;/button&gt;&lt;/td&gt; &lt;/tr&gt; `).join(''); } function deleteProduct(id) { products = products.filter(p =&gt; p.id !== id); renderAdminManageList(); renderFeatured(); renderCatalog(); } function renderAdminOrdersList() { const tbody = document.getElementById('admin-orders-list'); let localOrders = JSON.parse(localStorage.getItem('sakura_orders') || '[]'); if(localOrders.length === 0) { tbody.innerHTML = `&lt;tr&gt;&lt;td colspan=&quot;5&quot; class=&quot;p-4 text-center text-gray-500&quot;&gt;Nenhum pedido registrado ainda.&lt;/td&gt;&lt;/tr&gt;`; return; } tbody.innerHTML = localOrders.map(o =&gt; ` &lt;tr class=&quot;border-b border-neutral-800 text-xs&quot;&gt; &lt;td class=&quot;p-2&quot;&gt;${o.timestamp}&lt;/td&gt; &lt;td class=&quot;p-2&quot;&gt;${o.clientName}&lt;/td&gt; &lt;td class=&quot;p-2&quot;&gt;${o.clientPhone}&lt;/td&gt; &lt;td class=&quot;p-2&quot;&gt;${o.productName}&lt;/td&gt; &lt;td class=&quot;p-2&quot;&gt;${o.color} / ${o.size}&lt;/td&gt; &lt;/tr&gt; `).join(''); }&lt;/script&gt;</pre>
</body>
</html>
